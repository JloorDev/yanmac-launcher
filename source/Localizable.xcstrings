    "Herramientas" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tools"
          }
        }
      }
    },
    "Homebrew es el instalador que usa esta app para traer WINE (lo que permite correr el juego de Windows en tu Mac). Solo se instala una vez." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew is the installer this app uses to bring in WINE (which lets you run the Windows game on your Mac). It only needs to be installed once."
          }
        }
      }
    },
